{
  "name": "qtdn",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --build --force && tsc --noEmit -p apps/mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "build:ios": "npm run export --workspace @qtdn/mobile",
    "test:coverage": "vitest run --coverage",
    "e2e": "npm run build:web --workspace @qtdn/mobile && node e2e/flows.mjs",
    "latency": "vite-node e2e/latency.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^3.23.1",
    "globals": "^15.15.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite-node": "^6.0.0",
    "vitest": "^2.1.5"
  }
}
